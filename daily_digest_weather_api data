# ==================== API Functions ====================

def get_news_headlines(limit=5):
    """Fetch top news headlines from NewsAPI"""
    try:
        url = "https://newsapi.org/v2/top-headlines"
        params = {
            "country": "in",  # India
            "apiKey": NEWS_API_KEY,
            "pageSize": limit
        }
        response = requests.get(url, params=params, timeout=10)
        response.raise_for_status()
        
        articles = response.json().get("articles", [])
        headlines = []
        for article in articles:
            headlines.append({
                "title": article.get("title", "N/A"),
                "description": article.get("description", "N/A"),
                "url": article.get("url", "#"),
                "source": article.get("source", {}).get("name", "Unknown")
            })
        return headlines
    except Exception as e:
        print(f"Error fetching news: {e}")
        return []

def get_weather(city, api_key):
    """Fetch weather data using OpenWeatherMap API"""
    try:
        url = "https://api.openweathermap.org/data/2.5/weather"
        params = {
            "q": city,
            "appid": api_key,
            "units": "metric"
        }
        response = requests.get(url, params=params, timeout=10)
        response.raise_for_status()
        
        data = response.json()
        weather = {
            "city": data.get("name"),
            "temperature": data.get("main", {}).get("temp"),
            "condition": data.get("weather", [{}])[0].get("main"),
            "humidity": data.get("main", {}).get("humidity"),
            "wind_speed": data.get("wind", {}).get("speed")
        }
        return weather
    except Exception as e:
        print(f"Error fetching weather: {e}")
        return {}

def get_motivational_quote():
    """Fetch a motivational quote from ZenQuotes API"""
    try:
        url = "https://zenquotes.io/api/random"
        response = requests.get(url, timeout=10)
        response.raise_for_status()
        
        data = response.json()[0]
        quote = {
            "text": data.get("q"),
            "author": data.get("a", "Unknown").replace("-", "").strip()
        }
        return quote
    except Exception as e:
        print(f"Error fetching quote: {e}")
        return {"text": "Every day is a new opportunity to learn and grow!", "author": "Unknown"}

